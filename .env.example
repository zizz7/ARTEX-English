# Docker deployment config (copy to .env)
# Image built by scripts/build-image.sh (artex:local, or artex:kali for the full toolset).
ARTEX_IMAGE=artex:local
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Interface the UI (8787) and recording proxy (8788) are published on. Default 127.0.0.1 = this machine only.
# Use 0.0.0.0 only behind a firewall or TLS reverse proxy: the first visitor to a fresh install sets the admin password.
ARTEX_BIND=127.0.0.1

# LLM (fill in one or both; or leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
